def create_table(frame, data):
   
  for widget in frame.winfo_children():
        widget.destroy()
headers = [&quot;    &quot;, &quot;Fairprice&quot;, &quot;Giant&quot;, &quot;Sheng Siong&quot;, &quot;Cold Storage&quot;, &quot;Prime&quot;]
        column_width = 15

    for j, header in enumerate(headers):
        header_label = tk.Label(frame, text=header, borderwidth=0.5, relief=&quot;solid&quot;,
width=column_width, bg=&quot;lightblue&quot;)
        header_label.grid(row=0, column=j)
    all_prices = [(i, j, float(data[i][j].strip(&quot;$&quot;))) for i in range(len(data)) for j in range(1, 6)]
    min_price_cell = min(all_prices, key=lambda x: x[2])  # (row, col, price)
    max_price_cell = max(all_prices, key=lambda x: x[2])  # (row, col, price)

    for i, row_data in enumerate(data):
        for j, cell_data in enumerate(row_data):
            if j == 0:  # Highlight Brand column
                bg_color = &quot;lightblue&quot;
            elif (i, j) == (min_price_cell[0], min_price_cell[1]):
                bg_color = &quot;lightgreen&quot;  # Highlight lowest price
            elif (i, j) == (max_price_cell[0], max_price_cell[1]):
                bg_color = &quot;salmon&quot;  # Highlight highest price
            else:
                bg_color = &quot;white&quot;  # Default background
            cell_label = tk.Label(frame, text=cell_data, borderwidth=0.5, relief=&quot;solid&quot;,
width=column_width, bg=bg_color)
            cell_label.grid(row=i+1, column=j)
